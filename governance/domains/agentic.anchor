type: domain
namespace: AGT
version: "1.0"
anchor_version: ">=5.0.0"
maintainer: "Anchor Core Governance Engine"
always_loaded: true
description: >
  Agentic AI risks unique to autonomous, tool-calling, and
  multi-agent systems. These risks operate at the intent and
  reasoning layer — structurally distinct from code-level
  security violations. Enable this domain for any system
  deploying AI agents, MCP integrations, autonomous pipelines,
  or multi-agent orchestration frameworks.
seal: "sha256:PENDING"

rules:
  - id: "AGT-001"
    name: "Agent Action Authorization Bypass"
    source: "FINOS"
    original_id: "Ri-024"
    category: "security"
    description: >
      An AI agent executes actions outside its granted permissions
      not because a code-level permission check failed, but because
      the agent's reasoning layer decided to act without consulting
      the enforcement layer at all.
    severity: "blocker"
    min_severity: "blocker"
    runtime_pattern: '(?i)(bypass|override|admin|root|sudo|unauthorized|permissions)'
    min_mitigations: 1
    primitives:
      action: execute
      object: unauthorized_action
      context: intent_failure
      authority: agentic_reasoning
      flow: bypass_enforcement

  - id: "AGT-002"
    name: "Tool Chain Manipulation and Injection"
    source: "FINOS"
    original_id: "Ri-025"
    category: "security"
    description: >
      An attacker manipulates parameters, outputs, or metadata
      of tools called by an AI agent to corrupt the agent's reasoning
      or redirect its actions.
    severity: "blocker"
    min_severity: "error"
    runtime_pattern: '(?i)(tool output|fabricated|interceptor|poisoned tool)'
    min_mitigations: 1
    primitives:
      action: manipulate
      object: tool_chain_feedback
      context: poisoned_feedback_loop
      authority: external_attacker
      flow: corrupted_reasoning

  - id: "AGT-003"
    name: "MCP Server Supply Chain Compromise"
    source: "FINOS"
    original_id: "Ri-026"
    category: "security"
    description: >
      A compromised or malicious Model Context Protocol (MCP) server
      poisons an AI agent's reasoning by returning fabricated tool
      schemas or injecting malicious instructions into tool descriptions.
    severity: "blocker"
    min_severity: "error"
    runtime_pattern: '(?i)(mcp server|manifest|tool schema|protocol error)'
    min_mitigations: 1
    primitives:
      action: poison
      object: tool_schemas
      context: compromised_mcp_server
      authority: malicious_integrated_service
      flow: reasoning_redirection

  - id: "AGT-004"
    name: "Agent State Persistence Poisoning"
    source: "FINOS"
    original_id: "Ri-027"
    category: "security"
    description: >
      An attacker injects malicious instructions, false memories, or
      behavioral backdoors into an AI agent's persistent state (vector store,
      long-term memory).
    severity: "error"
    min_severity: "warning"
    runtime_pattern: '(?i)(persistent state|memory|vector store|long-term memory)'
    min_mitigations: 1
    primitives:
      action: inject
      object: persistent_memory
      context: behavioral_backdoor
      authority: adversarial_actor
      flow: long_term_compromise

  - id: "AGT-005"
    name: "Multi-Agent Trust Boundary Violations"
    source: "FINOS"
    original_id: "Ri-028"
    category: "security"
    description: >
      In multi-agent systems, a compromised or manipulated agent propagates
      malicious behavior across the swarm by exploiting implicit trust between agents.
    severity: "blocker"
    min_severity: "blocker"
    runtime_pattern: '(?i)(multi-agent|swarm|delegate|orchestrator|trust boundary)'
    min_mitigations: 1
    primitives:
      action: propagate
      object: malicious_behavior
      context: swarm_implicit_trust
      authority: compromised_agent
      flow: cascading_failure
