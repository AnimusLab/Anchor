type: domain
namespace: SEC
version: "1.0"
anchor_version: ">=5.0.0"
maintainer: "Anchor Core Governance Engine"
always_loaded: true
description: >
  Core security domain rules covering prompt injection, data poisoning,
  unauthorized privilege escalation, key exposure, and model weight tampering.
seal: "sha256:PENDING"

rules:
  - id: "SEC-001"
    name: "Direct & Indirect Prompt Injection"
    source: "OWASP"
    original_id: "LLM01"
    category: "security"
    description: >
      Untrusted input manipulates LLM instructions or system prompts, leading to unauthorized action execution.
    severity: "blocker"
    min_severity: "blocker"
    runtime_pattern: '(?i)(ignore previous instructions|system prompt override|jailbreak|disregard guidelines)'
    min_mitigations: 1
    primitives:
      action: inject
      object: prompt_instruction
      context: untrusted_user_input
      authority: adversarial_actor
      flow: prompt_compromise

  - id: "SEC-002"
    name: "Sensitive Data & Credential Exposure"
    source: "OWASP"
    original_id: "LLM06"
    category: "security"
    description: >
      API keys, JWT tokens, connection strings, or PII exposed in prompts, model outputs, or log streams.
    severity: "blocker"
    min_severity: "error"
    runtime_pattern: '(?i)(api[_-]?key|secret[_-]?key|bearer\s+[a-z0-9\-\._~\+\/]+=*|password\s*=)'
    min_mitigations: 1
    primitives:
      action: leak
      object: credential_secret
      context: telemetry_or_prompt
      authority: software_execution
      flow: exfiltration_path
