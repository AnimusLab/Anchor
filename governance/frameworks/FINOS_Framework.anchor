type: framework
namespace: FINOS
version: "1.0"
anchor_version: ">=5.0.0"
maintainer: "Anchor Core Governance Engine"
source: "FINOS AI Governance Framework"
seal: "sha256:PENDING"

rules:
  - id: "FINOS-001"
    name: "AI Agent Privilege Boundaries"
    original_id: "Ri-024"
    maps_to: "AGT-001"
    severity: "blocker"
    description: >
      AI agent must not bypass pre-execution authorization gates during tool execution.

  - id: "FINOS-002"
    name: "Tool Output Poisoning Guard"
    original_id: "Ri-025"
    maps_to: "AGT-002"
    severity: "blocker"
    description: >
      Validation of feedback loops between tool responses and model reasoning.
