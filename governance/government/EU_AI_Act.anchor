type: framework
namespace: EU
version: "2024/1689"
anchor_version: ">=5.0.0"
maintainer: "Anchor Core Governance Engine"
opt_in: true
source: "European Union Artificial Intelligence Act (Regulation EU 2024/1689)"
seal: "sha256:PENDING"

rules:
  - id: "EU-ART9"
    name: "Risk Management System for High-Risk AI"
    original_id: "Article 9"
    maps_to: "SEC-001"
    obligation_type: audit
    severity: "blocker"
    min_severity: "blocker"
    description: >
      A risk management system shall be established, implemented, documented and maintained in relation to high-risk AI systems.
    primitives:
      action: establish
      object: risk_management_system
      context: high_risk_ai
      authority: provider
      flow: risk_assessment

  - id: "EU-ART14"
    name: "Human Oversight Implementation"
    original_id: "Article 14"
    maps_to: "AGT-001"
    obligation_type: detection
    severity: "blocker"
    min_severity: "blocker"
    description: >
      High-risk AI systems shall be designed and developed in such a way that they can be effectively overseen by natural persons.
    primitives:
      action: oversee
      object: autonomous_execution
      context: human_in_the_loop
      authority: human_operator
      flow: oversight_override
