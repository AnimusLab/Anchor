# ─────────────────────────────────────────────────────────────
# Anchor Governance Kernel — Automated Mitigation Database
# type: mitigation
# ─────────────────────────────────────────────────────────────

type: mitigation
version: "5.0.0"
anchor_version: ">=5.0.0"
maintainer: "Anchor Core Governance Engine"

mitigations:
  SEC-001:
    name: "Prompt Injection Defense"
    remediation: >
      Sanitize and wrap all user inputs in explicit instruction delimiters (<user_input>...</user_input>).
      Enforce systemic system prompt immutability and validate tool parameters before execution.

  SEC-005:
    name: "Authorization Gate Enforcement"
    remediation: >
      Ensure every API route or tool invocation checks `user.has_permission(action)` before executing.

  AGT-001:
    name: "Agent Action Authorization Guardrail"
    remediation: >
      Wrap all autonomous tool calls in a pre-execution verification interceptor. Require dual-key human approval
      for high-risk operations (e.g. wire transfers, configuration mutation).

  AGT-003:
    name: "MCP Server Cryptographic Attestation"
    remediation: >
      Cryptographically verify MCP server manifests and tool schemas before granting agent execution access.

  RBI-007:
    name: "CIMS Telemetry Decision Audit Chain Logging"
    remediation: >
      Ensure every financial decision emits an Ed25519-signed AuditEntry with model ID, version, and input/output SHA-256 hashes.

  RBI-014:
    name: "Credit Adverse Action Explainability"
    remediation: >
      Attach structured reason codes to all credit denial outcomes in accordance with RBI FREE-AI Recommendation 14.
